# Uncomment the following to prevent the httpoxy vulnerability
# See: https://httpoxy.org/
#<IfModule mod_headers.c>
#    RequestHeader unset Proxy
#</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine on
    RewriteRule    ^(\.well-known/.*)$ $1 [L]
    RewriteRule    ^$    webroot/    [L]
    RewriteRule    (.*) webroot/$1    [L]
</IfModule>

# ==========================================================================
# Security response headers
# Addresses the missing headers flagged by the security scan
# (CSP, X-Frame-Options, X-Content-Type-Options, Referrer-Policy,
# Permissions-Policy). Strict-Transport-Security is already present.
# ==========================================================================
<IfModule mod_headers.c>
    # Force HTTPS for a year, include subdomains, and allow preload listing.
    # (Only sent over HTTPS by browsers; harmless on HTTP.)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Prevent the site from being framed by others (clickjacking protection).
    Header always set X-Frame-Options "SAMEORIGIN"

    # Stop browsers from MIME-sniffing away from the declared content type.
    Header always set X-Content-Type-Options "nosniff"

    # Limit referrer information sent to other origins.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Restrict powerful browser features the site doesn't use.
    Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=(), fullscreen=(self)"

    # Cross-Origin-Opener-Policy: isolate our top-level window from documents it
    # opens or that open it. 'same-origin-allow-popups' keeps our own popups /
    # target="_blank" links (TicketNet, etix, reCAPTCHA) working while still
    # severing the opener relationship with cross-origin windows.
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

    # Referrer already limited above; also isolate cross-origin resource loads
    # at a same-site boundary (allows our own subdomain assets, blocks others
    # from embedding our resources cross-origin). 'same-site' is safe because
    # our assets and CDNs are referenced via normal <script>/<img>, not as
    # cross-origin no-cors embeds of THIS origin's resources.
    Header always set Cross-Origin-Resource-Policy "same-site"

    # Content-Security-Policy
    # -----------------------------------------------------------------
    # The app does NOT emit its own CSP, so we define one here. The site
    # relies on inline <script>/<style> blocks and third-party libraries
    # (Swiper, jQuery plugins) that internally use string evaluation
    # (eval / new Function). 'unsafe-eval' is therefore required in
    # script-src, and 'unsafe-inline' is required for the inline
    # scripts/styles used throughout the templates.
    #
    # Origins allowed:
    #   - self                         : our own assets
    #   - cdnjs.cloudflare.com         : Swiper, Font Awesome
    #   - Cloudflare Insights          : analytics beacon and reporting
    #   - fonts.googleapis.com/gstatic : Google Fonts (Poppins)
    #   - www.googletagmanager.com     : Google Analytics tag loader
    #   - *.google-analytics.com,
    #     *.analytics.google.com       : GA4 hit collection (connect-src)
    #   - www.google.com / gstatic     : reCAPTCHA (contact form)
    #   - aci-cms.aranetacity.com      : CMS-hosted images
    #   - ticketnet.com.ph / etix      : ticketing links/frames
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://static.cloudflareinsights.com https://www.googletagmanager.com https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; img-src 'self' data: https: blob:; connect-src 'self' https://aci-cms.aranetacity.com https://ticketnet.com.ph https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://stats.g.doubleclick.net https://cloudflareinsights.com; frame-src 'self' https://www.google.com https://ticketnet.com.ph https://www.etix.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://www.google.com"
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php85” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php85 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
